model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Shifts","Downtime","Lines","Production","Products","Targets","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Shifts
ref table Downtime
ref table Lines
ref table Production
ref table Products
ref table Targets
ref table Date
ref table _Measures

ref cultureInfo en-US

