		isNameInferred
		sourceColumn: [MonthKey]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(CALENDAR(DATE(2025,1,1), DATE(2026,12,31)),
				  "Year", YEAR([Date]),
				  "MonthNum", MONTH([Date]),
				  "Month", FORMAT([Date], "MMM yyyy"),
				  "MonthKey", FORMAT([Date], "yyyy-MM"))

	annotation PBI_Id = 83e3396634ad43c39f3038c46f001f0d

