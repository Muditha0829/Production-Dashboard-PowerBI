		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 644ab833-ced5-4184-8fa1-e9468370df1f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNum
		formatString: 0
		lineageTag: 1115fc4b-274b-48ca-8e9b-c1baea1dc195
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MonthNum]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: dateTime
		formatString: mmmm yyyy
		lineageTag: b3b0140f-bf47-46f4-a62e-317f2b0caf54
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthKey

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column MonthKey
